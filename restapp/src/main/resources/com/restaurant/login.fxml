<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="400.0" prefWidth="500.0" style="-background-color: #ecf0f1;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.restaurant.controllers.LoginController">
   <children>
      <VBox alignment="CENTER" layoutX="75.0" layoutY="50.0" prefHeight="300.0" prefWidth="350.0" spacing="15.0" style="-background-color: #ffffff; -fx-background-radius: 10; -fx-padding: 20;">
         <children>
            <Label text="Рестораны POS Систем" textFill="#2c3e50">
               <font>
                  <Font name="System Bold" size="20.0" />
               </font>
            </Label>
            <Label text="Кассчны нэвтрэх хэсэг" textFill="#7f8c8d">
               <font>
                  <Font size="14.0" />
               </font>
               <VBox.margin>
                  <Insets bottom="10.0" />
               </VBox.margin>
            </Label>
            
            <!-- Хэрэглэгчийн нэр оруулах -->
            <TextField fx:id="txtUsername" promptText="Хэрэглэгчийн нэр" style="-fx-pref-height: 35;" />
            
            <!-- Нууц үг оруулах -->
            <PasswordField fx:id="txtPassword" promptText="Нууц үг" style="-fx-pref-height: 35;" />
            
            <!-- Нэвтрэх товч -->
            <Button fx:id="btnLogin" defaultButton="true" mnemonicParsing="false" onAction="#handleLogin" prefHeight="35.0" prefWidth="350.0" style="-fx-background-color: #27ae60;" text="Нэвтрэх" textFill="WHITE">
               <font>
                  <Font name="System Bold" size="14.0" />
               </font>
            </Button>
            
            <!-- Алдааны мессеж харуулах шошго -->
            <Label fx:id="lblError" textFill="#e74c3c">
               <font>
                  <Font size="12.0" />
               </font>
            </Label>
         </children>
      </VBox>
   </children>
</AnchorPane>