<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="700.0" prefWidth="1000.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.restaurant.controllers.CashierController">
   
   <!-- Дээд хэсэг (Гарчиг болон Кассчны мэдээлэл) -->
   <top>
      <HBox alignment="CENTER_LEFT" prefHeight="60.0" prefWidth="1000.0" style="-fx-background-color: #2c3e50;" BorderPane.alignment="CENTER">
         <children>
            <Label text="Рестораны Кассын Систем (POS)" textFill="WHITE">
               <font>
                  <Font name="System Bold" size="20.0" />
               </font>
               <HBox.margin>
                  <Insets left="20.0" />
               </HBox.margin>
            </Label>
         </children>
      </HBox>
   </top>

   <!-- Зүүн тал: Цэс сонгох хэсэг -->
   <left>
      <VBox prefHeight="640.0" prefWidth="400.0" spacing="10.0" style="-background-color: #ecf0f1;" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
         </padding>
         <children>
            <Label text="Цэсний жагсаалт">
               <font>
                  <Font name="System Bold" size="14.0" />
               </font>
            </Label>
            <!-- Энд цэсний хоолнуудыг харуулах GridPane эсвэл ListView байна -->
            <TableView fx:id="menuTable" prefHeight="550.0" prefWidth="370.0">
              <columns>
                <TableColumn fx:id="colItemName" prefWidth="240.0" text="Хоолны нэр" />
                <TableColumn fx:id="colItemPrice" prefWidth="129.0" text="Үнэ" />
              </columns>
            </TableView>
         </children>
      </VBox>
   </left>

   <!-- Баруун тал: Захиалгын сагс болон Тооцоо хийх хэсэг -->
   <center>
      <VBox prefHeight="640.0" prefWidth="600.0" spacing="10.0" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
         </padding>
         <children>
            <Label text="Идэвхтэй захиалга">
               <font>
                  <Font name="System Bold" size="14.0" />
               </font>
            </Label>
            
            <!-- Захиалсан хоолнуудын хүснэгт -->
            <TableView fx:id="orderTable" prefHeight="280.0" prefWidth="570.0">
              <columns>
                <TableColumn fx:id="colOrderName" prefWidth="200.0" text="Хоол" />
                <TableColumn fx:id="colOrderPrice" prefWidth="100.0" text="Нэгж үнэ" />
                  <TableColumn fx:id="colOrderQty" prefWidth="90.0" text="Тоо ширхэг" />
                  <TableColumn fx:id="colOrderSubTotal" prefWidth="179.0" text="Дэд дүн" />
              </columns>
            </TableView>

            <!-- Нийт дүн хэсэг -->
            <HBox alignment="CENTER_RIGHT" spacing="10.0">
               <children>
                  <Label text="Нийт төлөх дүн:">
                     <font>
                        <Font name="System Bold" size="16.0" />
                     </font>
                  </Label>
                  <Label fx:id="lblTotalAmount" text="0.00 ₮" textFill="#c0392b">
                     <font>
                        <Font name="System Bold" size="18.0" />
                     </font>
                  </Label>
               </children>
            </HBox>

            <!-- Төлбөр тооцоо хийх хяналтын хэсэг -->
            <VBox spacing="8.0" style="-background-color: #f9f9f9; -fx-border-color: #bdc3c7; -fx-border-radius: 5;">
               <padding>
                  <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
               </padding>
               <children>
                  <HBox spacing="15.0">
                     <children>
                        <Label text="Төлбөрийн хэлбэр:" />
                        <ComboBox fx:id="cmbPaymentMethod" prefWidth="150.0" promptText="Сонгох" />
                     </children>
                  </HBox>
                  <HBox spacing="15.0">
                     <children>
                        <Label text="Өгсөн мөнгө:" />
                        <TextField fx:id="txtCashGiven" promptText="0.00" />
                     </children>
                  </HBox>
                  <HBox spacing="15.0">
                     <children>
                        <Label text="Хариулт мөнгө:" />
                        <Label fx:id="lblChange" text="0.00 ₮">
                           <font>
                              <Font name="System Bold" size="14.0" />
                           </font>
                        </Label>
                     </children>
                  </HBox>
               </children>
            </VBox>

            <!-- Үйлдлийн товчнууд -->
            <HBox alignment="CENTER_RIGHT" spacing="10.0">
               <children>
                  <Button fx:id="btnRemoveItem" mnemonicParsing="false" onAction="#handleRemoveItem" style="-fx-background-color: #e74c3c;" text="Хасах" textFill="WHITE" />
                  <Button fx:id="btnClearOrder" mnemonicParsing="false" onAction="#handleClearOrder" style="-fx-background-color: #95a5a6;" text="Цэвэрлэх" textFill="WHITE" />
                  <Button fx:id="btnPayAndPrint" mnemonicParsing="false" onAction="#handlePayAndPrint" style="-fx-background-color: #27ae60;" text="Төлөх &amp; Баримт хэвлэх" textFill="WHITE">
                     <font>
                        <Font name="System Bold" size="12.0" />
                     </font>
                  </Button>
               </children>
            </HBox>
         </children>
      </VBox>
   </center>
</BorderPane>